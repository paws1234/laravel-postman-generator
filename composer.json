{
  "name": "paws1234/laravel-postman-generator",
  "description": "Generate Postman collections & environments from Laravel routes and FormRequests.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "paws1234\\LaravelPostmanGenerator\\": "src/"
    }
  },
  "autoload-dev": {
    "Tests\\": "tests/"
  },
  "extra": {
    "laravel": {
      "providers": [
        "paws1234\\LaravelPostmanGenerator\\PostmanGeneratorServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
